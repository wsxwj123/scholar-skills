{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_feed_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_feed_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/context_feed_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/academic_gate_hook.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/bash_guard_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
